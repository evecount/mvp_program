rules_version = '2';

// Mamba MVP — application pipeline.
//
// GENERATED by functions/src/build-form.ts from the catalogue in functions/src/mamba/ — do not edit this file by hand.
//
// The public site may only CREATE an application. Nobody can read, list, edit
// or delete one from a browser. The Cloud Function (functions/src/index.ts)
// re-validates every answer against the catalogue, scores it, and mails the
// dossier; reviewers read applications in the Firebase console.
service cloud.firestore {
  match /databases/{database}/documents {

    match /mvp_applications/{applicationId} {
      allow read, update, delete: if false;
      allow create: if isValidApplication(request.resource.data);
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }

    function fields() {
      return ['fullName', 'phone', 'email', 'track', 'intake', 'currentSituation', 'company',
              'role', 'yearsExperience', 'ideaTitle', 'domainProximity', 'problemEvidence',
              'competitors', 'alreadyDone', 'teamGaps', 'shippedBefore', 'outsideSignal',
              'ventureOneLiner', 'stage', 'firstCustomers', 'businessModel', 'residency',
              'firstTimeFounder', 'coFounderCount', 'incorporation', 'localEquity',
              'proprietaryTech', 'capitalToMatch', 'overseasAmbition', 'linkedin', 'portfolio',
              'github', 'availability', 'weekPlan', 'runway', 'dependents', 'employerAware',
              'setback', 'milestoneContract', 'accountableTo', 'wrongAssumption', 'failureMode',
              'firstThirtyDays', 'worthwhileIfNotFunded', 'grantIntent', 'priorPublicFunding',
              'motivation', 'howHeard', 'consent', 'acceptTerms', 'acceptPrivacy', 'cohort',
              'status', 'schemaVersion', 'createdAt'];
    }

    // Inline size checks rather than a helper: a helper call per field pushes
    // a ~50-field application past the 1,000-expression limit per request.
    // Types are re-checked by the Cloud Function, which rejects anything off.
    function isValidApplication(d) {
      let keys = fields();
      return d.keys().hasOnly(keys)
        && d.keys().hasAll(keys)
        && d.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
        && d.track in ['employee', 'founder', 'transition', 'cybrdeck-engineer']
        && d.intake in ['1 Month', '3 Month']
        && d.consent == true
        && d.acceptTerms == true
        && d.acceptPrivacy == true
        && ((d.cohort == '2027-01-26' && request.time < timestamp.value(1800666000000)))
        && d.status == 'pending'
        && d.schemaVersion == 2
        && d.createdAt == request.time
        && d.fullName.size() > 0 && d.phone.size() > 0 && d.email.size() > 0 && d.currentSituation.size() > 0 && d.motivation.size() > 0
        && d.fullName.size() <= 200
        && d.phone.size() <= 32
        && d.email.size() <= 320
        && d.currentSituation.size() <= 2000
        && d.company.size() <= 200
        && d.role.size() <= 200
        && d.ideaTitle.size() <= 120
        && d.problemEvidence.size() <= 2000
        && d.competitors.size() <= 1200
        && d.alreadyDone.size() <= 2000
        && d.teamGaps.size() <= 1200
        && d.ventureOneLiner.size() <= 500
        && d.firstCustomers.size() <= 1200
        && d.businessModel.size() <= 1200
        && d.linkedin.size() <= 500
        && d.portfolio.size() <= 500
        && d.github.size() <= 500
        && d.weekPlan.size() <= 1200
        && d.setback.size() <= 2000
        && d.accountableTo.size() <= 200
        && d.wrongAssumption.size() <= 1500
        && d.failureMode.size() <= 1200
        && d.firstThirtyDays.size() <= 1200
        && d.worthwhileIfNotFunded.size() <= 1200
        && d.motivation.size() <= 4000
        && d.yearsExperience.size() <= 200
        && d.domainProximity.size() <= 200
        && d.shippedBefore.size() <= 200
        && d.outsideSignal.size() <= 200
        && d.stage.size() <= 200
        && d.residency.size() <= 200
        && d.firstTimeFounder.size() <= 200
        && d.coFounderCount.size() <= 200
        && d.incorporation.size() <= 200
        && d.localEquity.size() <= 200
        && d.proprietaryTech.size() <= 200
        && d.capitalToMatch.size() <= 200
        && d.overseasAmbition.size() <= 200
        && d.availability.size() <= 200
        && d.runway.size() <= 200
        && d.dependents.size() <= 200
        && d.employerAware.size() <= 200
        && d.milestoneContract.size() <= 200
        && d.grantIntent.size() <= 200
        && d.priorPublicFunding.size() <= 200
        && d.howHeard.size() <= 200;
    }
  }
}
